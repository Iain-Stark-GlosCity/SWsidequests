{
  "routes": [
    { "route": "/v2", "redirect": "/v2/", "statusCode": 301 },
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/api/config", "methods": ["GET"], "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/me", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/v2/admin.html", "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/v2/signin.html",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/css/*",
      "/js/*",
      "/v2/css/*",
      "/v2/js/*",
      "/*.css",
      "/*.js",
      "/*.mjs",
      "/*.json",
      "/*.{png,jpg,jpeg,gif,svg,ico,webp,woff,woff2,ttf,eot}"
    ]
  },
  "mimeTypes": {
    ".jsx": "text/babel",
    ".css": "text/css",
    ".js": "text/javascript",
    ".mjs": "text/javascript",
    ".json": "application/json",
    ".svg": "image/svg+xml",
    ".woff": "font/woff",
    ".woff2": "font/woff2"
  }
}
